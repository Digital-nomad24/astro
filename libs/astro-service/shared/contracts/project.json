{
  "name": "astro-service-contracts",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/astro-service/shared/contracts/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:contracts"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/astro-service/shared/contracts",
        "command": "tsc -p tsconfig.lib.json"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "watch": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/astro-service/shared/contracts",
        "command": "tsc -p tsconfig.lib.json --watch --preserveWatchOutput"
      }
    }
  }
}

# Copy to apps/astro-api/.env and fill in every <ANGLE_BRACKET> placeholder.
#
#   cp apps/astro-api/.env.example apps/astro-api/.env
#   npm run db:migrate && npm run dev
#
# This project uses MANAGED services — nothing is self-hosted. If you would
# rather run Postgres/Redis/LiveKit locally instead, `docker-compose.yml` still
# provides all three; see the "local alternative" notes on each block below.

# ---- runtime ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
ENABLE_SWAGGER=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# WEB_APP_ORIGIN=https://app.example.com

# ---- Postgres (managed: Neon / Supabase / Cloud SQL / RDS) ----
# MUST be the DIRECT (session-mode) URL, never the pooled one. Prisma
# interactive transactions — which the wallet ledger depends on — break against
# a transaction-mode pooler, and only under concurrency, i.e. only in
# production. The app refuses to boot on a "-pooler" host, port 6543, or
# ?pgbouncer=true.
#   local alternative: postgresql://astro:astro@localhost:5432/astro
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?sslmode=require
ALLOW_POOLED_DATABASE_URL=false

# ---- Redis (managed: Upstash / Redis Cloud / Memorystore) ----
# TCP endpoint, NOT the Upstash REST URL — REST cannot do pub/sub or EVALSHA,
# and this app needs both. On Upstash the token is the password.
#   local alternative: redis://localhost:6379
REDIS_URL=rediss://default:<UPSTASH_TOKEN>@<UPSTASH_HOST>.upstash.io:6379
REDIS_ADAPTER_ENABLED=true

# ---- Firebase Auth ----
# Project id is not a secret; override it for a staging project if you have one.
FIREBASE_PROJECT_ID=astro-46881
# Pick ONE credential source. Preferred locally: Application Default
# Credentials via `gcloud auth application-default login`, with all three of
# these left unset. Production uses the Cloud Run service account, same path.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# FIREBASE_ADMIN_CREDENTIALS=C:/absolute/path/to/service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=C:/absolute/path/to/service-account.json
#
# Emulator only (`npm run emu:auth`). With this set, firebase-admin accepts
# UNSIGNED tokens — the env schema refuses to boot if it appears in production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
ADMIN_BOOTSTRAP_EMAILS=
# Public web API key. Needed only to run the e2e suite, which exchanges an Admin-minted custom
# token for a real ID token so the auth guard is exercised against genuine Google-signed JWTs.
FIREBASE_WEB_API_KEY=

# Firebase WEB client config — the API does not read any of this. It moves to
# apps/astro-web/.env when the mentor dashboard is built (M8); parked here so it
# is not lost. Public by design: these ship in the browser bundle, and the
# apiKey identifies the project rather than authorising anything. Access is
# controlled by Auth + security rules, not by secrecy.
#   VITE_FIREBASE_API_KEY=AIzaSyBE-ZwyXDCwzdiYrkOGpwGYfnFntbxtEYQ
#   VITE_FIREBASE_AUTH_DOMAIN=astro-46881.firebaseapp.com
#   VITE_FIREBASE_PROJECT_ID=astro-46881
#   VITE_FIREBASE_STORAGE_BUCKET=astro-46881.firebasestorage.app
#   VITE_FIREBASE_MESSAGING_SENDER_ID=315869329762
#   VITE_FIREBASE_APP_ID=1:315869329762:web:c742728ccc525df694143b
#   VITE_FIREBASE_MEASUREMENT_ID=G-E82P3PJHHF

# ---- LiveKit Cloud (voice) ----
# cloud.livekit.io -> project -> Settings -> Keys.
# Webhooks are verified with this same key/secret; there is no separate one.
# LiveKit Cloud cannot reach localhost, so local webhook work needs a tunnel
# (e.g. `cloudflared tunnel --url http://localhost:3000`).
#   local alternative: ws://localhost:7880 with devkey/secret
LIVEKIT_URL=wss://<PROJECT_SUBDOMAIN>.livekit.cloud
LIVEKIT_API_KEY=<LIVEKIT_API_KEY>
LIVEKIT_API_SECRET=<LIVEKIT_API_SECRET>
# LIVEKIT_WEBHOOK_SECRETS=<NEW_SECRET>,<OLD_SECRET>   # csv, only during rotation

# ---- sessions ----
SESSION_MAX_DURATION_S=3300
RING_TIMEOUT_S=30
MEDIA_ESTABLISH_TIMEOUT_S=45
SESSION_REJOIN_GRACE_S=15
CHAT_IDLE_TIMEOUT_S=300
CHAT_SEND_RATE_LIMIT=30
CHAT_SEND_RATE_WINDOW_S=60
CHAT_HISTORY_PAGE_SIZE=50
CHAT_MESSAGE_MAX_LENGTH=4000

# ---- chat transcript retention ----
# Transcripts are working data, not the record. A conversation is kept this long after the
# session ends, summarised (M8), and then deleted; the summary is what survives.
CHAT_RETENTION_DAYS=7
# The backstop: deleted at this age whether or not a summary was ever produced. Both halves
# are needed — delete-on-summarise alone leaks transcripts forever when the summariser breaks.
# Must be >= CHAT_RETENTION_DAYS; the env schema refuses to boot otherwise.
#
# NOTE while M8 is outstanding: nothing can produce a summary yet, so every completed chat
# reaches this backstop unread. Raise it if M8 slips well past a month.
CHAT_HARD_DELETE_DAYS=30

# ---- reviews ----
# How long after a consultation ends it can still be rated. Bounded so the aggregate reflects
# recent service, and so an old session cannot be dredged up to rating-bomb a mentor.
REVIEW_WINDOW_DAYS=30

# ---- presence ----
PRESENCE_HEARTBEAT_S=15
PRESENCE_TTL_S=45

# ---- queue ----
QUEUE_MAX_DEPTH=20
QUEUE_ENTRY_TTL_S=1800
QUEUE_DISCONNECT_GRACE_S=90
QUEUE_MENTOR_OFFLINE_GRACE_S=120
ETA_DEFAULT_SESSION_S=600

# ---- billing (M9) ----
BILLING_INTERVAL_S=60
BILLING_TICK_S=15
BILLING_MAX_INTERVALS_PER_TICK=10
MIN_SESSION_MINUTES=3
PLATFORM_COMMISSION_BPS=3000
PAYMENT_PROVIDER=manual
DEFAULT_CURRENCY=INR

# ---- infra ----
LEADER_LOCK_TTL_S=30
